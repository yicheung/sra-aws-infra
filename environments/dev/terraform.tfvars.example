region = "us-east-1"
name   = "sec-platform"

# --- VECTR ---
vectr_hostname            = "vectr.sec.example.com"
# Leave cert empty for SSM-only (no public ALB). Provide an ACM cert ARN
# (in this region) to front VECTR with an HTTPS ALB.
vectr_acm_certificate_arn = ""
vectr_allowed_cidrs       = ["203.0.113.0/24"] # your office/VPN CIDR

# --- Reporting ---
notification_emails = ["secops@example.com"]

# --- Remediation ---
# Start in dry-run (false); flip to true after reviewing logged actions.
auto_remediate = false

# --- TimberLake (OFFENSIVE — non-prod only) ---
deploy_timberlake                     = false
timberlake_target_account_id          = ""            # a dedicated non-prod account
timberlake_allowed_target_account_ids = []            # e.g. ["111122223333"]
